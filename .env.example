
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

CONTACT_TO=info@fusionautolab.com

# ---------------------------------------------------------------------------
# Content editor at /admin
# ---------------------------------------------------------------------------
# Lets the owner change site text without touching code. Saving commits the
# JSON in src/content/ to GitHub, which triggers a rebuild.
#
# ADMIN_PASSWORD  what the owner types at /admin. Pick something long; it is
#                 the only thing standing between the internet and the site's
#                 wording. Give it to him directly, not over email.
# ADMIN_SECRET    optional. Signs the session cookie-equivalent. Any long
#                 random string. Changing it signs everyone out.
# GITHUB_TOKEN    a fine-grained personal access token, scoped to THIS repo
#                 only, with Contents: read and write. Nothing else.
# GITHUB_REPO     owner/repo
# GITHUB_BRANCH   optional, defaults to main. Must be the branch Netlify builds.

ADMIN_PASSWORD=
ADMIN_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=Jxk0be/fusion-auto-lab-official
GITHUB_BRANCH=main
